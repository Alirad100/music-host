// 1) نمایش فیلدهای قیمت در فرم Quick Edit
add_action( 'woocommerce_product_quick_edit_start', function() {
    global $post;
    $product = wc_get_product( $post->ID );
    if ( ! $product ) {
        return;
    }
    $regular_price = $product->get_regular_price();
    $sale_price    = $product->get_sale_price();
    ?>
    <br class="clear" />
    <label>
        <span class="title"><?php esc_html_e( 'قیمت (تومان)', 'woocommerce' ); ?></span>
        <span class="input-text-wrap">
            <input type="text" name="_regular_price" class="text regular_price" value="<?php echo esc_attr( $regular_price ); ?>" />
        </span>
    </label>
    <label>
        <span class="title"><?php esc_html_e( 'قیمت حراج (تومان)', 'woocommerce' ); ?></span>
        <span class="input-text-wrap">
            <input type="text" name="_sale_price" class="text sale_price" value="<?php echo esc_attr( $sale_price ); ?>" />
        </span>
    </label>
    <br class="clear" />
    <?php
} );

// 2) ذخیره‌سازی مقدار قیمت هنگام ثبت Quick Edit
add_action( 'woocommerce_product_quick_edit_save', function( $product ) {
    if ( isset( $_REQUEST['_regular_price'] ) ) {
        $product->set_regular_price( wc_format_decimal( wp_unslash( $_REQUEST['_regular_price'] ) ) );
    }
    if ( isset( $_REQUEST['_sale_price'] ) ) {
        $sale = wp_unslash( $_REQUEST['_sale_price'] );
        $product->set_sale_price( '' === $sale ? '' : wc_format_decimal( $sale ) );
    }
    $product->save();
} );
